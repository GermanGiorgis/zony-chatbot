# Gemini API key (free, no credit card): https://aistudio.google.com/apikey
# Without any key the chat still runs, in demo mode (canned answers, calculator, clock and weather).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Groq API key (free): used as a backup when every Gemini model has run out of quota.
# https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Gemini models to try in order when one hits its free daily limit.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Optional: how long to wait for the first word of a reply (ms) before moving on to the next model.
# GEMINI_START_TIMEOUT_MS=8000

# Optional: Google Search grounding. Only works on a paid Gemini tier (5,000 free searches/month there).
# GEMINI_WEB_SEARCH=true

# Alternative backend: Vercel AI Gateway (used only when no Gemini key is set).
# AI_GATEWAY_API_KEY=
# CHAT_MODEL=google/gemini-3.5-flash-lite

# Development only: other devices on your network that may open the dev server (comma separated).
# ALLOWED_DEV_ORIGINS=192.168.0.10
