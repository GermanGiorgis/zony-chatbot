{
  "name": "zony-chatbot",
  "version": "0.1.0",
  "description": "Chatbot de IA con streaming, lectura de archivos, voz y un robot 3D personalizable (Next.js, Vercel AI SDK, React Three Fiber).",
  "license": "MIT",
  "author": "German Giorgis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GermanGiorgis/zony-chatbot.git"
  },
  "homepage": "https://zony-chatbot.vercel.app",
  "bugs": {
    "url": "https://github.com/GermanGiorgis/zony-chatbot/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "posters": "node scripts/capture-posters.mjs",
    "scenes": "node scripts/build-scenes.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "qa:api": "node scripts/qa/api.mjs",
    "qa:ui": "node scripts/qa/chat-flow.mjs",
    "qa:scenes": "node scripts/qa/scenes.mjs",
    "screenshots": "node scripts/qa/screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/groq": "^4.0.52",
    "@ai-sdk/react": "^4.0.119",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "ai": "^7.0.116",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.10",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
